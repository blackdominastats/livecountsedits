# Copy this file to .env and fill in the values.
# Never commit your real .env file or share your bot token.

DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
# Optional but recommended while testing: register commands instantly in one server.
DISCORD_GUILD_ID=YOUR_SERVER_ID
# Discord channel where the bot should post milestone alerts
DISCORD_CHANNEL_ID=1564921945047175174

# Local website-to-bot bridge
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
